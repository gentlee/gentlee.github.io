{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run clean-and-copy-images && npm run generate-xss-atom && next dev",
    "build": "npm run clean-and-copy-images && npm run generate-xss-atom && npm run lint && next build",
    "serve": "npx serve out",
    "start": "next start",
    "lint": "eslint .",
    "generate-xss-atom": "tsx src/fs/rss-atom.ts",
    "clean-and-copy-images": "rm -rf public/articles && rsync -zavr --include='*.webp' --include='*/' --exclude='*' articles public",
    "to-webp": "cwebp input.png -o output.webp"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "feed": "6.0.0",
    "highlight.js": "11.12.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-extract-frontmatter": "3.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  }
}
